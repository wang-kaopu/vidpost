{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2023",
    "types": ["node", "electron"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "forge.config.ts",
    "main.ts",
    "preload.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [".build", "app", "node_modules"]
}
