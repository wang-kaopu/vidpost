{
  "name": "agenthunt",
  "version": "1.0.0",
  "description": "agenthunt",
  "productName": "agenthunt",
  "authors": "kelvinwww", 
  "main": "main.cjs",
  "scripts": {
    "build:renderer": "pnpm --dir app run build",
    "test": "node --test",
    "start": "node ./scripts/start-electron.cjs",
    "forge start": "pnpm exec electron-forge start",
    "forge package": "pnpm run build:renderer && pnpm exec electron-forge package",
    "forge make": "pnpm run build:renderer && pnpm exec electron-forge make"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  },
  "dependencies": {
    "axios": "^1.15.2",
    "electron-squirrel-startup": "^1.0.1",
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "electron": "41.5.0"
  }
}
